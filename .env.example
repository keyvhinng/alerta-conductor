# Copy to .env for local development. Never commit .env or real credentials.
# Values below are local-development placeholders only.

# --- PostgreSQL (infra/docker-compose.yml) ---
POSTGRES_USER=alerta
POSTGRES_PASSWORD=alerta_dev_only
POSTGRES_DB=alerta
POSTGRES_PORT=5432

# --- API (apps/api) ---
API_PORT=8080
DATABASE_URL=postgres://alerta:alerta_dev_only@localhost:5432/alerta?sslmode=disable
# When true (default), data is labeled as simulated. Set to "false" only with real integrations.
SIMULATION_MODE=true
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Dashboard (apps/dashboard) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Driver monitor (apps/driver-monitor) ---
API_BASE_URL=http://localhost:8080
